# Copy to ~/.dbt/profiles.yml (or keep in project dir and run with --profiles-dir .)
# Auth: gcloud auth application-default login
smg_listings_dwh:
  target: dev
  outputs:
    dev:                                  # personal sandbox project
      type: bigquery
      method: oauth
      project: dime-smg-task
      dataset: vladimir_dimitric          # models land in vladimir_dimitric_staging / _intermediate / _marts
      location: EU
      threads: 4
      job_execution_timeout_seconds: 600
      priority: interactive
    smg:                                  # SMG interview project
      type: bigquery
      method: oauth
      project: smg-ch-automotive-interview
      dataset: vladimir_dimitric
      location: EU
      threads: 4
      job_execution_timeout_seconds: 600
      priority: interactive
